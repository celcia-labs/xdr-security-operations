        "# ============================================\n",
        "# SCRIPT 2: VirusTotal IP Enrichment\n",
        "# Purpose: Check suspicious IPs against threat intelligence\n",
        "# API: VirusTotal v3 (free — get key at virustotal.com)\n",
        "# ============================================\n",
        "\n",
        "import requests\n",
        "import time\n",
        "\n",
        "# Get your free API key at https://www.virustotal.com/gui/join-us\n",
        "VT_API_KEY = \""your_actual_api_key"\"  # <-- REPLACE THIS\n",
        "\n",
        "def check_ip_virustotal(ip, api_key):\n",
        "    \"\"\"Query VirusTotal for IP reputation.\"\"\"\n",
        "    url = f\"https://www.virustotal.com/api/v3/ip_addresses/{ip}\"\n",
        "    headers = {\"x-apikey\": api_key}\n",
        "    try:\n",
        "        response = requests.get(url, headers=headers)\n",
        "        if response.status_code == 200:\n",
        "            stats = response.json()[\"data\"][\"attributes\"][\"last_analysis_stats\"]\n",
        "            malicious = stats.get(\"malicious\", 0)\n",
        "            risk = \"HIGH\" if malicious > 5 else \"MEDIUM\" if malicious > 0 else \"LOW\"\n",
        "            return {\"ip\": ip, \"risk\": risk, \"malicious\": malicious,\n",
        "                    \"country\": response.json()[\"data\"][\"attributes\"].get(\"country\", \"?\"),\n",
        "                    \"owner\": response.json()[\"data\"][\"attributes\"].get(\"as_owner\", \"?\")}\n",
        "        else:\n",
        "            return {\"ip\": ip, \"risk\": \"UNKNOWN\", \"error\": f\"HTTP {response.status_code}\"}\n",
        "    except Exception as e:\n",
        "        return {\"ip\": ip, \"risk\": \"ERROR\", \"error\": str(e)}\n",
        "\n",
        "# IPs flagged by Script 1\n",
        "suspicious_ips = [\"203.0.113.50\", \"198.51.100.99\", \"192.0.2.77\", \"1.1.1.1\"]\n",
        "\n",
        "print(\"=\" * 50)\n",
        "print(\"  VIRUSTOTAL IP ENRICHMENT\")\n",
        "print(\"=\" * 50)\n",
        "\n",
        "for ip in suspicious_ips:\n",
        "    print(f\"\\n  Checking {ip}...\")\n",
        "    result = check_ip_virustotal(ip, VT_API_KEY)\n",
        "    if \"error\" not in result:\n",
        "        print(f\"    Risk: {result['risk']} | Malicious: {result['malicious']}\")\n",
        "        print(f\"    Country: {result['country']} | Owner: {result['owner']}\")\n",
        "    else:\n",
        "        print(f\"    {result['error']}\")\n",
        "    time.sleep(15)  # Rate limit: 4 requests/min on free tier\n",
        "\n",
        "print(\"\\n\" + \"=\" * 50)\n",
        "print(\"  ENRICHMENT COMPLETE\")\n",
        "print(\"=\" * 50)"
      ],
