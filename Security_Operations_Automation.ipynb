        "# ============================================\n",
        "# SCRIPT 3: Auto-Triage + Daily SOC Report\n",
        "# Purpose: Triage endpoint alerts + generate combined report\n",
        "# ============================================\n",
        "\n",
        "from datetime import datetime\n",
        "\n",
        "# Endpoint alert data (same as your GitHub repo)\n",
        "alerts = [\n",
        "  {\"alert_id\": \"EDR-001\", \"severity\": \"High\", \"title\": \"Suspicious encoded PowerShell execution\", \"device\": \"WORKSTATION-042\", \"user\": \"celcia.rajan\", \"mitre\": \"T1059.001\"},\n",
        "  {\"alert_id\": \"EDR-002\", \"severity\": \"Critical\", \"title\": \"EICAR test file detected\", \"device\": \"WORKSTATION-042\", \"user\": \"celcia.rajan\", \"mitre\": \"T1204.002\"},\n",
        "  {\"alert_id\": \"EDR-003\", \"severity\": \"Medium\", \"title\": \"Outbound connection to known C2 domain\", \"device\": \"LAPTOP-CELCIA\", \"user\": \"celcia.rajan\", \"mitre\": \"T1071.001\"},\n",
        "  {\"alert_id\": \"EDR-004\", \"severity\": \"Low\", \"title\": \"PUA detected: browser toolbar\", \"device\": \"DESKTOP-JMART\", \"user\": \"j.martinez\", \"mitre\": \"T1176\"},\n",
        "  {\"alert_id\": \"EDR-005\", \"severity\": \"High\", \"title\": \"Credential dumping tool detected\", \"device\": \"SERVER-DC01\", \"user\": \"svc_backup\", \"mitre\": \"T1003.001\"},\n",
        "  {\"alert_id\": \"EDR-006\", \"severity\": \"Medium\", \"title\": \"Lateral movement via SMB\", \"device\": \"FILESERVER-01\", \"user\": \"svc_backup\", \"mitre\": \"T1021.002\"}\n",
        "]\n",
        "\n",
        "def triage_alert(alert):\n",
        "    \"\"\"Decide response action based on severity.\"\"\"\n",
        "    severity = alert[\"severity\"]\n",
        "    if severity == \"Critical\":\n",
        "        return \"ESCALATE\", \"Page on-call. Isolate host. P1 ticket.\", \"15 min\"\n",
        "    elif severity == \"High\":\n",
        "        return \"ESCALATE\", \"Create P2 ticket. Assign to analyst.\", \"1 hour\"\n",
        "    elif severity == \"Medium\":\n",
        "        return \"INVESTIGATE\", \"Add to triage queue. Review within shift.\", \"4 hours\"\n",
        "    else:\n",
        "        return \"LOG\", \"Log for metrics. Weekly review.\", \"Next day\"\n",
        "\n",
        "# --- Run Triage ---\n",
        "print(\"=\" * 60)\n",
        "print(\"  AUTOMATED ALERT TRIAGE\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "for alert in alerts:\n",
        "    action, response, sla = triage_alert(alert)\n",
        "    print(f\"\\n  [{action}] {alert['alert_id']} — {alert['title']}\")\n",
        "    print(f\"    Severity: {alert['severity']} | Device: {alert['device']}\")\n",
        "    print(f\"    MITRE: {alert['mitre']}\")\n",
        "    print(f\"    Response: {response}\")\n",
        "    print(f\"    SLA: {sla}\")\n",
        "\n",
        "# --- Daily Report ---\n",
        "print(\"\\n\\n\" + \"=\" * 60)\n",
        "print(\"  DAILY SOC REPORT\")\n",
        "print(f\"  Date: {datetime.now().strftime('%Y-%m-%d')}\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(f\"\\n  Auth Events: {len(auth_logs)} | Failed: {failed} | Success: {success}\")\n",
        "print(f\"  Brute Force IPs: {len(brute_force)}\")\n",
        "print(f\"  Impossible Travel: {len(impossible_travel)}\")\n",
        "print(f\"  Endpoint Alerts: {len(alerts)}\")\n",
        "\n",
        "sev_counts = {}\n",
        "for a in alerts:\n",
        "    sev_counts[a['severity']] = sev_counts.get(a['severity'], 0) + 1\n",
        "print(f\"\\n  Alerts by Severity:\")\n",
        "for sev, count in sorted(sev_counts.items()):\n",
        "    print(f\"    {sev}: {count}\")\n",
        "\n",
        "escalated = len([a for a in alerts if a['severity'] in ['Critical', 'High']])\n",
        "print(f\"\\n  Escalated (P1/P2): {escalated}\")\n",
        "print(f\"  Under Investigation: {len([a for a in alerts if a['severity'] == 'Medium'])}\")\n",
        "\n",
        "mitre = list(set(a['mitre'] for a in alerts))\n",
        "print(f\"\\n  MITRE Techniques Observed:\")\n",
        "for t in mitre:\n",
        "    print(f\"    - {t}\")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"  END OF REPORT\")\n",
        "print(\"=\" * 60)"
