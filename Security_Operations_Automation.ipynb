        "# ============================================\n",
        "# SCRIPT 1: Authentication Log Parser\n",
        "# Purpose: Parse auth logs, detect brute force, flag suspicious patterns\n",
        "# MITRE: T1110 (Brute Force), T1078 (Valid Accounts)\n",
        "# ============================================\n",
        "\n",
        "import json\n",
        "from collections import Counter\n",
        "from datetime import datetime\n",
        "\n",
        "# Sample auth log data (same as your GitHub repo)\n",
        "auth_logs = [\n",
        "  {\"timestamp\": \"2026-10-10T02:14:33Z\", \"event\": \"failed_login\", \"source_ip\": \"203.0.113.50\", \"username\": \"celcia.rajan\", \"status\": \"failure\", \"reason\": \"invalid_password\", \"country\": \"CN\"},\n",
        "  {\"timestamp\": \"2026-10-10T02:14:36Z\", \"event\": \"failed_login\", \"source_ip\": \"203.0.113.50\", \"username\": \"admin\", \"status\": \"failure\", \"reason\": \"invalid_password\", \"country\": \"CN\"},\n",
        "  {\"timestamp\": \"2026-10-10T02:14:40Z\", \"event\": \"failed_login\", \"source_ip\": \"203.0.113.50\", \"username\": \"celcia.rajan\", \"status\": \"failure\", \"reason\": \"invalid_password\", \"country\": \"CN\"},\n",
        "  {\"timestamp\": \"2026-10-10T02:14:44Z\", \"event\": \"failed_login\", \"source_ip\": \"203.0.113.50\", \"username\": \"root\", \"status\": \"failure\", \"reason\": \"invalid_password\", \"country\": \"CN\"},\n",
        "  {\"timestamp\": \"2026-10-10T02:14:48Z\", \"event\": \"failed_login\", \"source_ip\": \"203.0.113.50\", \"username\": \"celcia.rajan\", \"status\": \"failure\", \"reason\": \"invalid_password\", \"country\": \"CN\"},\n",
        "  {\"timestamp\": \"2026-10-10T02:15:01Z\", \"event\": \"failed_login\", \"source_ip\": \"203.0.113.50\", \"username\": \"svc_backup\", \"status\": \"failure\", \"reason\": \"invalid_password\", \"country\": \"CN\"},\n",
        "  {\"timestamp\": \"2026-10-10T02:15:05Z\", \"event\": \"failed_login\", \"source_ip\": \"203.0.113.50\", \"username\": \"celcia.rajan\", \"status\": \"failure\", \"reason\": \"account_locked\", \"country\": \"CN\"},\n",
        "  {\"timestamp\": \"2026-10-10T08:30:12Z\", \"event\": \"successful_login\", \"source_ip\": \"10.0.0.15\", \"username\": \"celcia.rajan\", \"status\": \"success\", \"reason\": \"mfa_passed\", \"country\": \"CA\"},\n",
        "  {\"timestamp\": \"2026-10-10T09:02:45Z\", \"event\": \"successful_login\", \"source_ip\": \"10.0.0.22\", \"username\": \"j.martinez\", \"status\": \"success\", \"reason\": \"mfa_passed\", \"country\": \"CA\"},\n",
        "  {\"timestamp\": \"2026-10-10T11:45:33Z\", \"event\": \"failed_login\", \"source_ip\": \"198.51.100.99\", \"username\": \"admin\", \"status\": \"failure\", \"reason\": \"invalid_password\", \"country\": \"RU\"},\n",
        "  {\"timestamp\": \"2026-10-10T11:45:38Z\", \"event\": \"failed_login\", \"source_ip\": \"198.51.100.99\", \"username\": \"celcia.rajan\", \"status\": \"failure\", \"reason\": \"invalid_password\", \"country\": \"RU\"},\n",
        "  {\"timestamp\": \"2026-10-10T14:20:00Z\", \"event\": \"successful_login\", \"source_ip\": \"10.0.0.15\", \"username\": \"celcia.rajan\", \"status\": \"success\", \"reason\": \"sso\", \"country\": \"CA\"},\n",
        "  {\"timestamp\": \"2026-10-10T18:05:22Z\", \"event\": \"failed_login\", \"source_ip\": \"192.0.2.77\", \"username\": \"celcia.rajan\", \"status\": \"failure\", \"reason\": \"impossible_travel\", \"country\": \"NG\"},\n",
        "  {\"timestamp\": \"2026-10-10T22:30:00Z\", \"event\": \"successful_login\", \"source_ip\": \"172.16.0.5\", \"username\": \"svc_monitor\", \"status\": \"success\", \"reason\": \"service_account\", \"country\": \"CA\"}\n",
        "]\n",
        "\n",
        "# --- Analysis Functions ---\n",
        "def detect_brute_force(logs, threshold=5):\n",
        "    failed = [l for l in logs if l[\"status\"] == \"failure\"]\n",
        "    ip_counts = Counter(l[\"source_ip\"] for l in failed)\n",
        "    results = []\n",
        "    for ip, count in ip_counts.items():\n",
        "        if count >= threshold:\n",
        "            users = list(set(l[\"username\"] for l in failed if l[\"source_ip\"] == ip))\n",
        "            country = next(l[\"country\"] for l in failed if l[\"source_ip\"] == ip)\n",
        "            results.append({\"ip\": ip, \"attempts\": count, \"users\": users, \"country\": country})\n",
        "    return results\n",
        "\n",
        "def detect_impossible_travel(logs):\n",
        "    return [l for l in logs if l.get(\"reason\") == \"impossible_travel\"]\n",
        "\n",
        "def detect_after_hours(logs):\n",
        "    return [l for l in logs if l[\"status\"] == \"success\" and (int(l[\"timestamp\"][11:13]) < 8 or int(l[\"timestamp\"][11:13]) > 18)]\n",
        "\n",
        "# --- Run Analysis ---\n",
        "brute_force = detect_brute_force(auth_logs)\n",
        "impossible_travel = detect_impossible_travel(auth_logs)\n",
        "after_hours = detect_after_hours(auth_logs)\n",
        "\n",
        "total = len(auth_logs)\n",
        "failed = len([l for l in auth_logs if l[\"status\"] == \"failure\"])\n",
        "success = len([l for l in auth_logs if l[\"status\"] == \"success\"])\n",
        "\n",
        "print(\"=\" * 55)\n",
        "print(\"  AUTHENTICATION LOG ANALYSIS REPORT\")\n",
        "print(f\"  Generated: {datetime.now().strftime('%Y-%m-%d %H:%M')}\")\n",
        "print(\"=\" * 55)\n",
        "print(f\"\\nTotal Events: {total} | Success: {success} | Failed: {failed}\")\n",
        "\n",
        "print(f\"\\n--- BRUTE FORCE DETECTIONS ({len(brute_force)}) ---\")\n",
        "for bf in brute_force:\n",
        "    print(f\"  IP: {bf['ip']} ({bf['country']}) — {bf['attempts']} attempts\")\n",
        "    print(f\"    Targeted: {', '.join(bf['users'])}\")\n",
        "    print(f\"    MITRE: T1110.001 — Brute Force: Password Guessing\")\n",
        "\n",
        "print(f\"\\n--- IMPOSSIBLE TRAVEL ({len(impossible_travel)}) ---\")\n",
        "for it in impossible_travel:\n",
        "    print(f\"  User: {it['username']} from {it['country']} at {it['timestamp']}\")\n",
        "    print(f\"    MITRE: T1078 — Valid Accounts\")\n",
        "\n",
        "print(f\"\\n--- AFTER-HOURS LOGINS ({len(after_hours)}) ---\")\n",
        "for ah in after_hours:\n",
        "    print(f\"  User: {ah['username']} at {ah['timestamp']}\")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 55)\n",
        "print(\"  ANALYSIS COMPLETE\")\n",
        "print(\"=\" * 55)"
      ]
